# =============================================================================
# Casino El Al3ab — Ramadan Tournament Platform
# Environment Variables Reference
# =============================================================================
#
# PROTOTYPE MODE (v0.1-pitch):
#   NO environment variables are required to run locally or deploy to Vercel /
#   Netlify. All data is served via async repositories backed by localStorage
#   seed data, and live cross-window sync uses Browser BroadcastChannel.
#
# PRODUCTION UPGRADE (Database, Auth, Multi-Device Realtime):
#   Uncomment and configure the variables below when swapping /lib/repos and
#   /lib/realtime to a hosted backend (see README.md & TODO.md).
# =============================================================================

# --- Database (PostgreSQL / Supabase / Prisma / Drizzle) ---------------------
# DATABASE_URL="postgresql://user:password@host:5432/casino_el_al3ab?sslmode=require"
# DIRECT_URL="postgresql://user:password@host:5432/casino_el_al3ab?sslmode=require"

# --- Authentication (Auth.js / NextAuth or Supabase Auth) --------------------
# NEXTAUTH_URL="https://your-domain.com"
# NEXTAUTH_SECRET="replace-with-32-byte-random-secret"
# NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
# NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
# SUPABASE_SERVICE_ROLE_KEY="your-server-only-service-role-key"

# --- Hosted Multi-Device Realtime (Supabase / Ably / Pusher / WebSocket) -----
# NEXT_PUBLIC_REALTIME_DRIVER="browser" # browser | supabase | ably | pusher | websocket
# NEXT_PUBLIC_REALTIME_URL="wss://realtime.your-domain.com"
# NEXT_PUBLIC_REALTIME_KEY="your-public-realtime-key"

# --- Optional Site Metadata --------------------------------------------------
# NEXT_PUBLIC_APP_URL="https://your-pitch-url.vercel.app"
